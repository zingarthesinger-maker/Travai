  "components": {
    "schemas": {
      "AdminProcessUrgentRequestDto": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "minLength": 1,
            "type": "string"
          },
          "adminNotes": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AgeType": {
        "enum": [
          "Adult",
          "Child",
          "Infant",
          "Senior"
        ],
        "type": "string"
      },
      "BookingStatus": {
        "enum": [
          "Pending",
          "Confirmed",
          "Cancelled",
          "Completed"
        ],
        "type": "string"
      },
      "CancellationPolicy": {
        "enum": [
          "Hours24",
          "Hours48",
          "Hours72"
        ],
        "type": "string"
      },
      "CreateTourDto": {
        "required": [
          "cancellationPolicy",
          "tourTitle"
        ],
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "nullable": true
          },
          "tourTitle": {
            "minLength": 1,
            "type": "string"
          },
          "tourType": {
            "type": "string",
            "nullable": true
          },
          "tourDescription": {
            "type": "string",
            "nullable": true
          },
          "basePriceUsd": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "currency": {
            "type": "string",
            "nullable": true
          },
          "durationHours": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "groupSizeMax": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "sitesCovered": {
            "type": "string",
            "nullable": true
          },
          "startingPoint": {
            "type": "string",
            "nullable": true
          },
          "ageRestriction": {
            "type": "string",
            "nullable": true
          },
          "transportIncluded": {
            "type": "boolean"
          },
          "mealsIncluded": {
            "type": "boolean"
          },
          "isAccessible": {
            "type": "boolean"
          },
          "accessibility": {
            "type": "string",
            "nullable": true
          },
          "customizable": {
            "type": "boolean"
          },
          "season": {
            "type": "string",
            "nullable": true
          },
          "includedServices": {
            "type": "string",
            "nullable": true
          },
          "excludedServices": {
            "type": "string",
            "nullable": true
          },
          "safetyMeasures": {
            "type": "string",
            "nullable": true
          },
          "bestTimeToVisit": {
            "type": "string",
            "nullable": true
          },
          "pickupDetails": {
            "type": "string",
            "nullable": true
          },
