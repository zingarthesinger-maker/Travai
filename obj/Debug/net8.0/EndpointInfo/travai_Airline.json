  "components": {
    "schemas": {
      "AddFundsDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "format": "double"
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BookingRequestDto": {
        "required": [
          "companionIds",
          "flightId",
          "numberOfSeats"
        ],
        "type": "object",
        "properties": {
          "flightId": {
            "type": "integer",
            "format": "int64"
          },
          "numberOfSeats": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "companionIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        },
        "additionalProperties": false
      },
      "CreateAirlineDto": {
        "required": [
          "country",
          "name",
          "userId"
        ],
        "type": "object",
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "country": {
            "minLength": 1,
            "type": "string"
          },
          "logoUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateAirportDto": {
        "required": [
          "city",
          "code",
          "country",
          "name"
        ],
        "type": "object",
        "properties": {
          "code": {
            "maxLength": 3,
            "minLength": 3,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "city": {
            "minLength": 1,
            "type": "string"
          },
          "country": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateCompanionDto": {
        "required": [
          "ageType",
          "firstName",
          "lastName"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "minLength": 1,
            "type": "string"
          },
          "ageType": {
            "minLength": 1,
            "type": "string"
          },
          "passportNumber": {
            "type": "string",
            "nullable": true
          },
          "nationality": {
            "type": "string",
            "nullable": true
          },
          "profilePic": {
